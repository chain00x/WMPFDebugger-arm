  "scripts": {
    "test": "TS_NODE_COMPILER_OPTIONS='{\"module\":\"CommonJS\"}' node -r ts-node/register --test test/*.test.cjs",
    "typecheck": "tsc --noEmit",
    "relay": "ts-node --compiler-options '{\"module\":\"CommonJS\"}' src/relay.ts",
    "test:frida": "node scripts/check-frida.mjs",
    "test:ui": "TS_NODE_COMPILER_OPTIONS='{\"module\":\"CommonJS\"}' node -r ts-node/register scripts/check-network-ui.mjs"
  },
  "dependencies": {
    "frida": "17.24.3",
    "protobufjs": "^7.5.4",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "@types/ws": "^8.18.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2"
  }
}
